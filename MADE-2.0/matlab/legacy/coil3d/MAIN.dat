! ! ! *GET, ULT_ND_96_2 ,NODE,0,NUM,MAX
! ! ! NSEL,S,NODE,,CAB_96
! ! ! *GET,YYMAX,NODE,0,MXLOC,Y 
! ! ! *GET,YYMIN,NODE,0,MNLOC,Y 
! ! ! *GET,ZZMAX,NODE,0,MXLOC,Z 
! ! ! *GET,ZZMIN,NODE,0,MNLOC,Z 
! ! ! Rm = 8.6
! ! ! Zm = 0
! ! ! ALLSEL
! ! ! NSEL,NONE
! ! ! TYPE,3
! ! ! *AFUN,RAD
! ! ! *DO,i,0,2*pi,2*pi/1000
	! ! ! N,,Rm*cos(i),Rm*sin(i),Zm
! ! ! *ENDDO
! ! ! CM,CAB_96_2,NODE
! ! ! ALLSEL
! ! ! !------------------------------------------------------------!
! ! ! ALLSEL,ALL,ALL
! ! ! RMIN=0
! ! ! RMAX=16
! ! ! ZMIN=-15
! ! ! ZMAX=15
! ! ! ANG=0
! ! ! NR=100
! ! ! NZ=100
! ! ! *DIM,RR,ARRAY,NR*NZ
! ! ! *DIM,ZZ,ARRAY,NR*NZ
! ! ! TYPE,3
! ! ! CSYS,2011
! ! ! *GET, ULT_NODE ,NODE,0,NUM,MAX
! ! ! NOFF=ULT_NODE+100 
! ! ! NK=0
! ! ! *DO,I,1,NZ
  ! ! ! ZPOS=ZMIN+(I-1)*(ZMAX-ZMIN)/(NZ-1)
  ! ! ! *DO,J,1,NR
	! ! ! RPOS=RMIN+(J-1)*(RMAX-RMIN)/(NR-1)
	! ! ! NK=NK+1
	! ! ! N,NOFF+NK,RPOS,ANG,ZPOS
	! ! ! RR(NK)=RPOS
	! ! ! ZZ(NK)=ZPOS
  ! ! ! *ENDDO
! ! ! *ENDDO
!------------------------------------------------------------!
/SOLU
ALLSEL,ALL,ALL
BIOT,NEW
FINISH
!------------------------------------------------------------!
!!! Cable
/POST1
ALLSEL
CSYS,0
RSYS,0

ALLSEL,ALL,ALL
NSEL,S,NODE,,CAB_96
*GET,NN_NODE,NODE,0,COUNT
*GET,nn_min,NODE,0,NUM,MIN
*GET,nn_max,NODE,0,NUM,MAX	
*DIM,B_,ARRAY,NN_NODE,7,1
	
p = nn_min-1			
*DO,n,1,NN_NODE 
	p = p+1
	*GET,B_(n,1),NODE,p,LOC,X
	*GET,B_(n,2),NODE,p,LOC,Y
	*GET,B_(n,3),NODE,p,LOC,Z
	*GET,BXCS,NODE,p,HS,X
	*GET,BYCS,NODE,p,HS,Y
	*GET,BZCS,NODE,p,HS,Z
	B_(n,4)=MU0*BXCS
	B_(n,5)=MU0*BYCS
	B_(n,6)=MU0*BZCS	
	B_(n,7)=sqrt(B_(n,4)**2+B_(n,5)**2+B_(n,6)**2)
*ENDDO 		
!------------------------------------------------------------!
*MWRITE,B_,B_,csv 
%G %G %G %G %G %G %G 
