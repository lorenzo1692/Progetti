	! ! ! p = p+1
	! ! ! *GET,B_T(n,1),NODE,p,LOC,X
	! ! ! *GET,B_T(n,2),NODE,p,LOC,Y
	! ! ! *GET,B_T(n,3),NODE,p,LOC,Z
	! ! ! *GET,BXCS,NODE,p,HS,X
	! ! ! *GET,BYCS,NODE,p,HS,Y
	! ! ! *GET,BZCS,NODE,p,HS,Z
	! ! ! B_T(n,4)=MU0*BXCS
	! ! ! B_T(n,5)=MU0*BYCS
	! ! ! B_T(n,6)=MU0*BZCS	
	! ! ! B_T(n,7)=sqrt(B_T(n,4)**2+B_T(n,5)**2+B_T(n,6)**2)
