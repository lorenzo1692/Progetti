FINISH
/CLEAR,ALL
/PREP7
/INPUT,'ParametriMatlab','txt'
!------------------------------------------------------------!
!!!  Element Definition
ET,1,200,1
ET,2,36
ET,3,96
ANG_DIV=360/N_TF
!------------------------------------------------------------!
!!! Local CSYS
LOCAL,2000,0,0.0,0.0,0.0
LOCAL,2001,0,,,,ANG_DIV/2 		! Cartesian local CS used for duplicating half-WP section
LOCAL,2011,1,,,,ANG_DIV/2+90 	! Cylindrical local CS used for assigning boundary conditions
LOCAL,2002,0,,,,-ANG_DIV/2		! Cartesian local CS to assign conditions to second WP
CSYS,0
*GET,MAX_CS,CDSY,0,NUM,MAX
PI=acos(-1)
D2R=PI/180
MU0=PI*4e-7
EPS=1e-4
!------------------------------------------------------------!
!!! NODI  
/PREP7
COL = 1
RIG = N_NODES*2+1
*DIM,radialC,array,RIG,COL
*VREAD, radialC, 'radialMatlab_VNS', 'txt',
(1F6.0)
*DIM,verticalC,array,RIG,COL
*VREAD, verticalC, 'verticalMatlab_VNS', 'txt',
(1F6.0)

ALLSEL,ALL,ALL
*GET, ULT_ND ,NODE,0,NUM,MAX
*GET,MAX_CS,CDSY,0,NUM,MAX
CSYS,0 
*DO,i,1,RIG
	N,ULT_ND+i,0.0,radialC(i),verticalC(i)
*ENDDO
 
ALLSEL,ALL,ALL
NUMMRG,NODE
NUMCMP,NODE
CM,SOURCEN,NODE

*GET,NNNODE,NODE,,COUNT

*GET, ULT_ND_3 ,NODE,0,NUM,MAX
*DO,i,1,RIG
	N,ULT_ND_3+i,0.5,radialC(i),verticalC(i)
*ENDDO

ALLSEL
NUMMRG,NODE,1e-4
NUMCMP,NODE
ALLSEL

!------------------------------------------------------------!
I_TF = -I_TF
WP_w = 1.0
WP_h = 0.5
TYPE,2
*DO,i,1,NNNODE-1
	R,i,2,I_TF,WP_h,WP_w,,,,,EPS
	REAL,i	 
	NI=ULT_ND+i
	NJ=ULT_ND+i+1
	NK=ULT_ND_3+i 
	E,NI,NJ,NK
*ENDDO	

i=i+1
R,i,2,I_TF,WP_h,WP_w,,,,,EPS
REAL,i	 
NI=NNNODE
NJ=1 
NK=ULT_ND_3+NNNODE-1
E,NI,NJ,NK

/SHRINK,0   
/ESHAPE,1 
/EFACET,1   
/RATIO,1,1,1
/CFORMAT,32,0 
EPLOT  
/REPLOT
ALLSEL,ALL,ALL

*GET,NO_NODES,NODE,,COUNT	
ESEL,S,TYPE,,2
NSLE,S,1	
CSYS,2011
EGEN,N_TF,NO_NODES+100,ALL,,,0,0,0,0,0,0,ANG_DIV,0	
PARSAV,SCALAR,PARM
  
!------------------------------------------------------------!
!!! NODI  
ALLSEL
NUMCMP,NODE
*GET, ULT_ND_96 ,NODE,0,NUM,MAX
NSEL,NONE
CSYS,0 
*DO,i,1,RIG
	N,ULT_ND_96+i,0.0,radialC(i),verticalC(i)
*ENDDO
NUMMRG,NODE
NUMCMP,NODE
CM,CAB_96,NODE
ALLSEL
