/PREP7
LSEL,,LCCAT
LDELE,ALL
ALLSEL,ALL,ALL
NUMCMP,LINE

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! DOUBLE PANCAKE INSULATION
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
THIS_MAT = INTLINS_MAT
THIS_ET = INTLINS_ET
THAT_MAT = JCK_MAT
ELM_SZ = LWIT!*2

VER_CS = MAX_CS
SELTOL,1e-4
*DO,i,1,GRADES-1!,2
	*IF,i,LE,NL_HIGHF-1,THEN
			k = 1
			
			CSYS,MAX_CS+8*((k-1)+NT_HIGHF*(i-1))+2

			KSEL,,LOC,Y,-HJH(i,k)-ICIT
			LSLK,,1
			CM,THIS_INTLINSu,LINE
			*GET,Xs,KP,,MNLOC,X
			*GET,Xd,KP,,MXLOC,X
			*GET,Yu,KP,,MNLOC,Y
			KSEL,ALL
			KSEL,S,KP,,KP(Xs,Yu,0)
			*GET,KP1s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd,Yu,0)
			*GET,KP1d,KP,,NUM,MAX		
			
			KSEL,,LOC,Y,-HJH(i,k)-ICIT-LWIT*2
			LSLK,,1
			CM,THIS_INTLINSd,LINE
			*GET,Yd,KP,,MNLOC,Y
			KSEL,ALL
			KSEL,S,KP,,KP(Xs,Yd,0)
			*GET,KP2s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd,Yd,0)
			*GET,KP2d,KP,,NUM,MAX
			
			ALLSEL,ALL,ALL
			
			LSEL,NONE
			L,KP1s,KP2s
			L,KP1d,KP2d
			CMSEL,A,THIS_INTLINSu,LINE
			CMSEL,A,THIS_INTLINSd,LINE
			ASEL,NONE
			AL,ALL
			ALLSEL,BELOW,AREA
			NUMMRG,NODE
			NUMMRG,KP
			CMSEL,S,THIS_INTLINSu,LINE
			LCCAT,ALL
			CMSEL,S,THIS_INTLINSd,LINE
			LCCAT,ALL
			AATT,THIS_MAT,,THIS_ET,TOP_CS
			MSHKEY,0
			MSHAPE,1
			ESIZE,ELM_SZ
			AMESH,ALL
			
			LSEL,,LCCAT
			LDELE,ALL
			
		*ELSEIF,i,EQ,NL_HIGHF,THEN
			k = 1
			
			CSYS,MAX_CS+8*(NL_HIGHF*NT_HIGHF+NT_LOWF*(i-NL_HIGHF-1)+(k-1))+2
			KSEL,,LOC,Y,-HJH(i,k)-ICIT
			LSLK,,1
			CM,THIS_INTLINSu,LINE
			*GET,Xs1,KP,,MNLOC,X
			*GET,Xd1,KP,,MXLOC,X
			*GET,Yu,KP,,MNLOC,Y
			KSEL,ALL
			KSEL,S,KP,,KP(Xs1,Yu,0)
			*GET,KP1s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd1,Yu,0)
			*GET,KP1d,KP,,NUM,MAX		
					
			KSEL,,LOC,Y,-HJH(i,k)-ICIT-LWIT*2
			LSLK,,1
			CM,THIS_INTLINSd,LINE
			*GET,Yd,KP,,MNLOC,Y
			*GET,Xs2,KP,,MNLOC,X
			*GET,Xd2,KP,,MXLOC,X
			KSEL,ALL
			KSEL,S,KP,,KP(Xs2,Yd,0)
			*GET,KP2s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd2,Yd,0)
			*GET,KP2d,KP,,NUM,MAX
			
			K,KP1d+1,Xs1,Yd
			K,KP1d+2,Xd1,Yd
			
			ALLSEL,ALL,ALL
			
			LSEL,NONE
			L,KP1s,KP1d+1
			L,KP2s,KP1d+1
			L,KP1d,KP1d+2
			L,KP2d,KP1d+2
			! LESIZE,ALL,0.001
			CMSEL,A,THIS_INTLINSu,LINE
			CMSEL,A,THIS_INTLINSd,LINE
			ASEL,NONE
			AL,ALL
			ALLSEL,BELOW,AREA
			NUMMRG,NODE
			NUMMRG,KP
			CMSEL,S,THIS_INTLINSu,LINE
			LCCAT,ALL
			CMSEL,S,THIS_INTLINSd,LINE
			LCCAT,ALL
			AATT,THIS_MAT,,THIS_ET,TOP_CS
			MSHKEY,0
			MSHAPE,1
			ESIZE,0.01
			AMESH,ALL	

			LSEL,,LCCAT
			LDELE,ALL
			
		*ELSE
		
			k = 1
			
			CSYS,MAX_CS+8*(NL_HIGHF*NT_HIGHF+NT_LOWF*(i-NL_HIGHF-1)+(k-1))+2
			KSEL,,LOC,Y,-HJH(i,k)-ICIT
			LSLK,,1
			CM,THIS_INTLINSu,LINE
			*GET,Xs,KP,,MNLOC,X
			*GET,Xd,KP,,MXLOC,X
			*GET,Yu,KP,,MNLOC,Y
			KSEL,ALL
			KSEL,S,KP,,KP(Xs,Yu,0)
			*GET,KP1s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd,Yu,0)
			*GET,KP1d,KP,,NUM,MAX		
			
			KSEL,,LOC,Y,-HJH(i,k)-ICIT-LWIT*2
			LSLK,,1
			CM,THIS_INTLINSd,LINE
			*GET,Yd,KP,,MNLOC,Y
			KSEL,ALL
			KSEL,S,KP,,KP(Xs,Yd,0)
			*GET,KP2s,KP,,NUM,MAX
			KSEL,ALL
			KSEL,S,KP,,KP(Xd,Yd,0)
			*GET,KP2d,KP,,NUM,MAX
			
			ALLSEL,ALL,ALL
			
			LSEL,NONE
			L,KP1s,KP2s
			L,KP1d,KP2d
			CMSEL,A,THIS_INTLINSu,LINE
			CMSEL,A,THIS_INTLINSd,LINE
			ASEL,NONE
			AL,ALL
			ALLSEL,BELOW,AREA
			NUMMRG,NODE
			NUMMRG,KP
			CMSEL,S,THIS_INTLINSu,LINE
			LCCAT,ALL
			CMSEL,S,THIS_INTLINSd,LINE
			LCCAT,ALL
			AATT,THIS_MAT,,THIS_ET,TOP_CS
			MSHKEY,0
			MSHAPE,1
			ESIZE,ELM_SZ
			AMESH,ALL
			
			LSEL,,LCCAT
			LDELE,ALL		
	*ENDIF
*ENDDO

ASEL,,MAT,,THAT_MAT,THIS_MAT,,1
ALLSEL,BELOW,AREA
NUMMRG,NODE,1e-5
NUMMRG,KP,1e-5


